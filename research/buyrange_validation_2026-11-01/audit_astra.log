  139: def error_stats(frame: pd.DataFrame, model: str) -> dict:
  140:     prediction = "eps_f4" if model == "F4" else "eps_nc"
  141:     target = "target4" if model == "F4" else "target_nc"
  142:     p = pd.to_numeric(frame[prediction], errors="coerce").to_numpy(dtype=float)
  143:     y = pd.to_numeric(frame[target], errors="coerce").to_numpy(dtype=float)
  144:     naive = pd.to_numeric(frame["eps_ttm"], errors="coerce").to_numpy(dtype=float)
  145:     mask = (
  146:         np.isfinite(p) & np.isfinite(y) & np.isfinite(naive)
  147:         & (y > 0) & (naive > 0)
  148:     )
  149:     result = dict.fromkeys(ERROR_FIELDS, np.nan)
  150:     result["n"] = int(mask.sum())
  151:     if not mask.any():
  152:         return result
  153:     e = (p[mask] - y[mask]) / y[mask]
  154:     e_naive = (naive[mask] - y[mask]) / y[mask]
  155:     for key, value in zip(
  156:         ("p10", "p25", "p50", "p75", "p90"),
  157:         np.percentile(e, [10, 25, 50, 75, 90]),
  158:     ):
  159:         result[key] = float(value)
  160:     mae = float(np.median(np.abs(e)))
  161:     mae_naive = float(np.median(np.abs(e_naive)))
  162:     result["median_absolute_error"] = mae
  163:     result["naive_median_absolute_error"] = mae_naive
  164:     result["skill"] = 1 - mae / mae_naive if mae_naive > 0 else np.nan
  165:     return result
  166: 
  167: 
  168: def spearman_rank_ic(x, y) -> float:
  169:     a = pd.Series(x, dtype=float).rank(method="average").to_numpy(dtype=float)
  170:     b = pd.Series(y, dtype=float).rank(method="average").to_numpy(dtype=float)
  171:     if len(a) < 2:
  172:         return np.nan
  173:     a, b = a - a.mean(), b - b.mean()
  174:     denominator = np.sqrt(np.dot(a, a) * np.dot(b, b))
  175:     return float(np.dot(a, b) / denominator) if denominator > 0 else np.nan
  176: 
  177: 
  178: def newey_west_t(values, lag=NW_LAG) -> float:
  179:     """�I�Z�����ƪ� Bartlett HAC�Fgamma_l �ϥΰ��H n ���w�q�C"""
  180:     x = np.asarray(values, dtype=float)
  181:     x = x[np.isfinite(x)]
  182:     n = len(x)
  183:     if n < 2:
  184:         return np.nan
  185:     u = x - x.mean()
  186:     long_run_variance = float(np.dot(u, u) / n)
  187:     for ell in range(1, min(lag, n - 1) + 1):
  188:         weight = 1 - ell / (lag + 1)
  189:         long_run_variance += 2 * weight * float(np.dot(u[ell:], u[:-ell]) / n)
  190:     if long_run_variance <= 0:
  191:         return np.nan
  192:     return float(x.mean() / np.sqrt(long_run_variance / n))
  193: 
  194: 
  195: def yearly_block_ci(point_rows) -> tuple[float, float, int]:
  196:     """��ӭ����~�@�_����A�O�d�C�~�����I�ơA�H�v�IIC���������p�q�C"""
  197:     valid = [
  198:         (pd.Timestamp(row["rd"]).year, number(row["ic"]))
  199:         for row in point_rows
  200:         if isfinite(row["ic"])
  201:     ]
  202:     years = sorted({year for year, _ in valid})
  203:     if len(years) < 2:
  204:         return np.nan, np.nan, len(years)
  205:     sums = np.array(
  206:         [sum(value for year, value in valid if year == y) for y in years],
  207:         dtype=float,
  208:     )
  209:     counts = np.array(
  210:         [sum(year == y for year, _ in valid) for y in years], dtype=float
  211:     )
  212:     rng = np.random.default_rng(BOOTSTRAP_SEED)
  213:     selected = rng.integers(0, len(years), size=(BOOTSTRAP_DRAWS, len(years)))
  214:     means = sums[selected].sum(axis=1) / counts[selected].sum(axis=1)
  215:     lo, hi = np.percentile(means, [2.5, 97.5])
  216:     return float(lo), float(hi), len(years)
  217: 
  218: 
  219: def growth_sample(frame: pd.DataFrame) -> pd.DataFrame:
  220:     columns = ["eps_f4", "eps_ttm", "target4"]
  221:     values = frame[columns].apply(pd.to_numeric, errors="coerce")
  222:     mask = np.isfinite(values.to_numpy(dtype=float)).all(axis=1)
  223:     mask &= values["eps_ttm"].gt(0).to_numpy()
  224:     mask &= values["target4"].gt(0).to_numpy()
  225:     result = frame.loc[mask, ["t", "rd"]].copy()
  226:     values = values.loc[mask]
  227:     result["predicted_growth"] = values["eps_f4"] / values["eps_ttm"] - 1
  228:     result["actual_growth"] = values["target4"] / values["eps_ttm"] - 1
  229:     return result
  230: 
  231: 
  232: def quintile_medians(frame: pd.DataFrame) -> tuple[dict, pd.DataFrame]:
  233:     result = dict.fromkeys(Q_FIELDS, np.nan)
  234:     assigned = frame.copy()
  235:     assigned["quintile"] = np.nan
  236:     if len(frame) >= 5:
  237:         # �����W���A���� ticker/��J���ǩ�ۦP�T���F�P�Ȧh�ɤ��\�Ť���C
  238:         assigned["quintile"] = np.ceil(
  239:             assigned["predicted_growth"].rank(method="average", pct=True) * 5
  240:         ).clip(1, 5)
  241:         for i in range(1, 6):
  242:             a = assigned.loc[assigned["quintile"].eq(i), "actual_growth"]
  243:             if not a.empty:
  244:                 result[f"q{i}_actual_growth_median"] = float(a.median())
  245:     return result, assigned
  246: 
  247: 
  248: def ic_analysis(frame: pd.DataFrame, dates) -> tuple[list[dict], dict]:
  249:     sample = growth_sample(frame)
  250:     rows, assigned_points = [], []
  251:     for rd in dates:
  252:         a = sample.loc[sample["rd"].eq(rd)]
  253:         qstats, assigned = quintile_medians(a)
  254:         rows.append(
  255:             {
  256:                 "scope": "point",
  257:                 "rd": rd,
  258:                 "n": len(a),
  259:                 "ic": spearman_rank_ic(a["predicted_growth"], a["actual_growth"]),
  260:                 **qstats,
  261:             }
  262:         )
  263:         assigned_points.append(assigned)
  264: 
  265:     pooled = pd.concat(assigned_points, ignore_index=True)
  266:     pooled_q = dict.fromkeys(Q_FIELDS, np.nan)
  267:     for i in range(1, 6):
  268:         a = pooled.loc[pooled["quintile"].eq(i), "actual_growth"]
  269:         if not a.empty:
  270:             pooled_q[f"q{i}_actual_growth_median"] = float(a.median())
  271: 
  272:     ics = np.array([number(row["ic"]) for row in rows], dtype=float)
  273:     finite = ics[np.isfinite(ics)]
  274:     lo, hi, years = yearly_block_ci(rows)
  275:     qvalues = [pooled_q[key] for key in Q_FIELDS]
  276:     q5_gt_q1 = (
  277:         isfinite(qvalues[0]) and isfinite(qvalues[-1])
  278:         and qvalues[-1] > qvalues[0]
  279:     )
  280:     monotonic = bool(
  281:         all(isfinite(x) for x in qvalues) and np.all(np.diff(qvalues) >= 0)
  282:     )
  283:     summary = {
  284:         "scope": "all",
  285:         "rd": "ALL",
  286:         "n": len(sample),
  287:         "ic_points": len(finite),
  288:         "ic_mean": float(finite.mean()) if len(finite) else np.nan,
  289:         "nw_lag": NW_LAG,
  290:         "nw_t": newey_west_t(ics),
  291:         "bootstrap_years": years,
  292:         "bootstrap_draws": BOOTSTRAP_DRAWS,
  293:         "bootstrap_seed": BOOTSTRAP_SEED,
  294:         "ci_low": lo,
  295:         "ci_high": hi,
  296:         **pooled_q,
  297:         "q5_gt_q1": bool(q5_gt_q1),
  298:         "quintiles_monotonic": monotonic,
  299:     }
  300:     return rows, summary
  301: 
  302: 
  303: def positive_direction(row) -> bool:
  304:     return bool(
  305:         isfinite(row["ic_mean"]) and row["ic_mean"] > 0
  306:         and row["q5_gt_q1"]
  307:     )
  308: 
