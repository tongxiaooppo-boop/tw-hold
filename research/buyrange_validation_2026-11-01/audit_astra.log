  455: def scoring_schedule(d, rd) -> dict:
  456:     """���@���������i���F����252�ӥ���馬�L�X���A���H�ʻ��黼���C"""
  457:     calendar = market_calendar(d)
  458:     i = calendar.searchsorted(pd.Timestamp(rd), side="right")
  459:     if i >= len(calendar):
  460:         return {
  461:             "entry_date": pd.NaT,
  462:             "exit_date": pd.NaT,
  463:             "reason": "�L�i�������",
  464:         }
  465:     entry = pd.Timestamp(calendar[i])
  466:     j = i + HOLDING_DAYS
  467:     if j >= len(calendar):
  468:         return {
  469:             "entry_date": entry,
  470:             "exit_date": pd.NaT,
  471:             "reason": "����252�ӫ�������",
  472:         }
  473:     exit_date = pd.Timestamp(calendar[j])
  474:     return {
  475:         "entry_date": entry,
  476:         "exit_date": exit_date,
  477:         "reason": "�X���W�L2026-10-30" if exit_date > EXIT_CUTOFF else "",
  478:     }
  479: 
