512:        c3 = bool(isfinite(trimmed["spread"]) and trimmed["spread"] > 0)
513:        c4 = chain_ok if group in MAIN_GROUPS else p20_chain_ok
514:        passed = bool(c1 and c2 and c3 and c4)
