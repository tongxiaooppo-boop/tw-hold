144:def _growth(monthly: pd.Series, window: int) -> float | None:
145:    if monthly.empty:
146:        return None
147:    current_index = pd.period_range(
148:        end=monthly.index[-1], periods=window, freq="M"
149:    )
150:    current = monthly.reindex(current_index).to_numpy(dtype=float)
151:    previous = monthly.reindex(current_index - G12_MONTHS).to_numpy(dtype=float)
152:    if not np.isfinite(current).all() or not np.isfinite(previous).all():
153:        return None
154:    current_sum = _number(current.sum())
155:    previous_sum = _number(previous.sum())
156:    if current_sum is None or previous_sum is None or previous_sum == 0:
157:        return None
158:    return _number(current_sum / previous_sum - 1)
