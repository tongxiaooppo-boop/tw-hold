177:def _seasonal_bias(q: pd.DataFrame, target: pd.Period) -> float:
178:    first = q.index[-1] - (SEASONAL_YEARS * QUARTERS_PER_YEAR - 1)
179:    observations = []
180:    for period in q.index[q.index >= first]:
181:        if period.quarter != target.quarter:
182:            continue
183:        quarter_margin = _gross_margin(q.loc[[period]])
184:        historical_ttm_margin = _gross_margin(_ttm_frame(q, period))
185:        if quarter_margin is None or historical_ttm_margin is None:
186:            continue
187:        deviation = _number(quarter_margin - historical_ttm_margin)
188:        if deviation is not None:
189:            observations.append(deviation)
190:    if len(observations) < MIN_SEASONAL_OBSERVATIONS:
191:        return 0.0
192:    signs = np.sign(observations)
193:    if not np.all(signs == signs[0]):
194:        return 0.0
195:    return float(np.mean(observations))
