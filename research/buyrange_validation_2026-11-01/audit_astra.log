262:def adjacent_direction_consistent(metrics: dict, names) -> bool:
263:    """四點鏈各相鄰端的內外差均為正；不要求差值大小單調。"""
264:    for left, right in zip(names[:-1], names[1:]):
265:        a = number(metrics[left]["spread"])
266:        b = number(metrics[right]["spread"])
267:        if not (isfinite(a) and isfinite(b) and a > 0 and b > 0):
268:            return False
269:    return True
