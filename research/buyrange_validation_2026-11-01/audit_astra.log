272:def band_month_stats(predictions) -> dict:
273:    values = np.asarray(
274:        [number(row["n_months"]) for row in predictions], dtype=float
275:    )
276:    values = values[np.isfinite(values)]
277:    if not len(values):
278:        return {
279:            "per_months_n": 0,
280:            "per_months_min": np.nan,
281:            "per_months_p25": np.nan,
282:            "per_months_p50": np.nan,
283:            "per_months_p75": np.nan,
284:            "per_months_max": np.nan,
285:            "per_months_ge48": 0,
286:        }
287:    q = np.percentile(values, [0, 25, 50, 75, 100])
288:    return {
289:        "per_months_n": len(values),
290:        **dict(
291:            zip(
292:                [
293:                    "per_months_min", "per_months_p25", "per_months_p50",
294:                    "per_months_p75", "per_months_max",
295:                ],
296:                map(float, q),
297:            )
298:        ),
299:        "per_months_ge48": int(np.sum(values >= MIN_MONTHS)),
300:    }
