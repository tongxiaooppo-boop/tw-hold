303:def bt1_price_restriction(out: Path) -> str:
304:    """只讀同資料夾既有BT1結果；不把BT1結果拿來改BT2格點或四條判定。"""
305:    path = out / "bt1_error_by_point.csv"
306:    if not path.exists():
307:        return (
308:            "尚未找到BT1結果：以下僅判定BT2方向性證據，不授權實際價格門檻。"
309:            "依預註冊，須另確認F4/NC沒有skill≤0的禁止條款。"
310:        )
311:    try:
312:        errors = pd.read_csv(path)
313:        base = errors.loc[
314:            errors["scope"].eq("all")
315:            & errors["cut"].eq("all")
316:            & errors["stratum"].eq("all")
317:        ]
318:        messages = []
319:        for model in ("F4", "NC"):
320:            a = base.loc[base["model"].eq(model), "skill"]
321:            skill = number(a.iloc[0]) if not a.empty else np.nan
322:            if not isfinite(skill):
323:                messages.append(f"{model} skill未知，不得據此授權價格門檻")
324:            elif skill <= 0:
325:                messages.append(
326:                    f"{model} skill={skill:.6g}≤0，依預註冊不得用於任何價格門檻"
327:                )
328:            else:
329:                messages.append(f"{model} skill={skill:.6g}>0")
330:        return "；".join(messages) + "。BT2四條檢查不取代上述先決限制。"
331:    except Exception as exc:
332:        log_error("", None, "read_bt1_restriction", exc)
333:        return "BT1結果讀取失敗；不得將BT2方向性通過視為價格門檻授權。"
