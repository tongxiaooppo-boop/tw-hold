  186: def point_in_time(d, t, rd) -> dict | None:
  187:     rd = pd.Timestamp(rd)
  188:     audit = _diagnostic(d, t, rd)
  189:     try:
  190:         h = _history(d, t)
  191:         q = h["q"].iloc[: h["q_deadlines"].searchsorted(rd, side="left")]
  192:         monthly = h["monthly"].iloc[
  193:             : h["m_deadlines"].searchsorted(rd, side="left")
  194:         ]
  195:         per = h["per"].iloc[: h["p_dates"].searchsorted(rd, side="left")]
  196: 
  197:         audit["n_q"] = len(q)
  198:         audit["has_8q"] = q["period_end"].dt.to_period("Q-DEC").nunique() >= 8
  199:         audit["has_gross"] = (
  200:             "gross_profit" in q
  201:             and pd.to_numeric(q["gross_profit"], errors="coerce").notna().any()
  202:         )
  203:         if not audit["has_8q"]:
  204:             audit["reason"] = "����8�u�]��"
  205:             return None
  206:         if not audit["has_gross"]:
  207:             audit["reason"] = "�ʤ�Q��Υ�NaN"
  208:             return None
  209:         return {"q": q, "monthly": monthly, "per": per}
  210:     except Exception as exc:
  211:         audit["reason"] = "PIT�ҥ~"
  212:         log_error(t, rd, "point_in_time", exc)
  213:         return None
