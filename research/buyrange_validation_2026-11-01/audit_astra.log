  407:     def fmt(x):
  408:         if x is None or x is pd.NA:
  409:             return "NA"
  410:         if isinstance(x, (float, np.floating)):
  411:             return f"{x:.6g}" if math.isfinite(float(x)) else "NA"
  412:         if isinstance(x, (bool, np.bool_)):
  413:             return "�O" if x else "�_"
  414:         if isinstance(x, pd.Timestamp):
  415:             return x.date().isoformat()
  416:         return str(x).replace("|", r"\|").replace("\n", " ")
  417: 
  418:     headers = [str(c) for c in frame.columns]
  419:     lines = [
