  226: def current_ttm(q: pd.DataFrame) -> float:
  227:     e = quarter_eps(q)
  228:     if e.empty:
  229:         return np.nan
  230:     a = e.reindex(pd.period_range(end=e.index[-1], periods=4, freq="Q-DEC"))
  231:     return float(a.sum()) if a.notna().all() else np.nan
  232: 
