  379: def market_calendar(d) -> pd.DatetimeIndex:
  380:     """�u������������F������󥼨ӻ���ƭȥ浹�w���ݡC"""
  381:     global _CALENDAR
  382:     _sync(d)
  383:     if _CALENDAR is None:
  384:         arrays = []
  385:         for x in d.get("px", {}).values():
  386:             if x is not None and not x.empty:
  387:                 dates = pd.DatetimeIndex(pd.to_datetime(x["date"])).dropna()
  388:                 arrays.append(dates.to_numpy(dtype="datetime64[ns]"))
  389:         idx = d.get("idx0050")
  390:         if idx is not None and not idx.empty:
  391:             dates = pd.DatetimeIndex(pd.to_datetime(idx["date"])).dropna()
  392:             arrays.append(dates.to_numpy(dtype="datetime64[ns]"))
  393:         _CALENDAR = (
  394:             pd.DatetimeIndex(np.unique(np.concatenate(arrays))).sort_values()
  395:             if arrays
  396:             else pd.DatetimeIndex([])
  397:         )
  398:     return _CALENDAR
