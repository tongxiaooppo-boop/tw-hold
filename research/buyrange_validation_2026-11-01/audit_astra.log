   74: def past_features(q, monthly, eps_ttm) -> dict:
   75:     result = {
   76:         "ttm_relative": np.nan,
   77:         "ttm_history_n": 0,
   78:         "revenue_growth_3m": np.nan,
   79:         "nonop_level": "unknown",
   80:     }
   81:     e = quarter_eps(q)
   82:     if not e.empty:
   83:         grid = pd.period_range(
   84:             end=e.index[-1], periods=HISTORY_TTM_ENDPOINTS + 3, freq="Q-DEC"
   85:         )
   86:         history = e.reindex(grid).rolling(4, min_periods=4).sum().iloc[-20:]
   87:         valid = history.loc[np.isfinite(history.to_numpy(dtype=float))]
   88:         result["ttm_history_n"] = len(valid)
   89:         if len(valid) >= MIN_HISTORY_TTMS:
   90:             med = number(valid.median())
   91:             if isfinite(med) and med > 0:
   92:                 result["ttm_relative"] = number(eps_ttm) / med
   93: 
   94:     if not monthly.empty:
   95:         m = pd.Series(
   96:             pd.to_numeric(monthly, errors="coerce").to_numpy(dtype=float),
   97:             index=pd.DatetimeIndex(monthly.index).to_period("M"),
   98:         )
   99:         if m.index.has_duplicates:
  100:             raise ValueError("���禬�P�뭫��")
  101:         current = pd.period_range(end=m.index.max(), periods=3, freq="M")
  102:         a = m.reindex(current).to_numpy(dtype=float)
  103:         b = m.reindex(current - 12).to_numpy(dtype=float)
  104:         if np.isfinite(a).all() and np.isfinite(b).all() and b.sum() != 0:
  105:             result["revenue_growth_3m"] = a.sum() / b.sum() - 1
  106: 
  107:     result["nonop_level"] = detect.nonop_gate(q).level
  108:     return result
  109: 
  110: 
  111: def select_stratum(frame: pd.DataFrame, stratum: str) -> pd.DataFrame:
  112:     if stratum == "all":
  113:         return frame
  114:     if stratum.startswith("ttm_"):
  115:         label = {
  116:             "ttm_high": "high",
  117:             "ttm_not_high": "not_high",
  118:             "ttm_unclassified": "unknown",
  119:         }[stratum]
  120:         return frame.loc[frame["ttm_class"].eq(label)]
  121:     if stratum.startswith("nonop_"):
  122:         return frame.loc[frame["nonop_level"].eq(stratum.removeprefix("nonop_"))]
  123:     g = pd.to_numeric(frame["revenue_growth_3m"], errors="coerce")
  124:     mask = {
  125:         "revenue_positive": g.gt(0),
  126:         "revenue_negative": g.lt(0),
  127:         "revenue_zero": g.eq(0),
  128:         "revenue_unknown": g.isna(),
  129:     }[stratum]
  130:     return frame.loc[mask]
  131: 
  132: 
  133: def select_cut(frame: pd.DataFrame, cut: str) -> pd.DataFrame:
  134:     if cut == "all":
  135:         return frame
  136:     return frame.loc[frame["target4_end"].lt(TARGET_2026)]
  137: 
