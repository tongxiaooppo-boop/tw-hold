  481: def scoring_trade(d, t, rd) -> dict:
  482:     schedule = scoring_schedule(d, rd)
  483:     result = {
  484:         **schedule,
  485:         "ok": False,
  486:         "ret": np.nan,
  487:         "ret_net": np.nan,
  488:         "benchmark_0050": np.nan,
  489:     }
  490:     if schedule["reason"]:
  491:         return result
  492:     try:
  493:         entry, exit_date = schedule["entry_date"], schedule["exit_date"]
  494:         x = _price_frame(d, t)
  495:         if entry not in x.index or exit_date not in x.index:
  496:             result["reason"] = "�i���ΥX�������ʻ�"
  497:             return result
  498:         open_entry = number(x.at[entry, "open"])
  499:         close_exit = number(x.at[exit_date, "close"])
  500:         if not (isfinite(open_entry) and isfinite(close_exit)):
