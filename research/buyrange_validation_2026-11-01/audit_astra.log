   79: def number(value) -> float:
   80:     try:
   81:         value = float(value)
   82:     except (TypeError, ValueError, OverflowError):
   83:         return float("nan")
   84:     return value if math.isfinite(value) else float("nan")
   85: 
   86: 
   87: def isfinite(value) -> bool:
   88:     return math.isfinite(number(value))
   89: 
   90: 
   91: def ratio(numerator, denominator) -> float:
   92:     a, b = number(numerator), number(denominator)
   93:     return a / b if math.isfinite(a) and math.isfinite(b) and b != 0 else np.nan
