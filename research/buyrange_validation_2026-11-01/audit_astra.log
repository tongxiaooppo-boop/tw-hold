139:def error_stats(frame: pd.DataFrame, model: str) -> dict:
140:    prediction = "eps_f4" if model == "F4" else "eps_nc"
141:    target = "target4" if model == "F4" else "target_nc"
142:    p = pd.to_numeric(frame[prediction], errors="coerce").to_numpy(dtype=float)
143:    y = pd.to_numeric(frame[target], errors="coerce").to_numpy(dtype=float)
144:    naive = pd.to_numeric(frame["eps_ttm"], errors="coerce").to_numpy(dtype=float)
145:    mask = (
146:        np.isfinite(p) & np.isfinite(y) & np.isfinite(naive)
147:        & (y > 0) & (naive > 0)
148:    )
149:    result = dict.fromkeys(ERROR_FIELDS, np.nan)
150:    result["n"] = int(mask.sum())
151:    if not mask.any():
152:        return result
153:    e = (p[mask] - y[mask]) / y[mask]
154:    e_naive = (naive[mask] - y[mask]) / y[mask]
155:    for key, value in zip(
156:        ("p10", "p25", "p50", "p75", "p90"),
157:        np.percentile(e, [10, 25, 50, 75, 90]),
158:    ):
159:        result[key] = float(value)
160:    mae = float(np.median(np.abs(e)))
161:    mae_naive = float(np.median(np.abs(e_naive)))
162:    result["median_absolute_error"] = mae
163:    result["naive_median_absolute_error"] = mae_naive
164:    result["skill"] = 1 - mae / mae_naive if mae_naive > 0 else np.nan
165:    return result
166:
167:
168:def spearman_rank_ic(x, y) -> float:
169:    a = pd.Series(x, dtype=float).rank(method="average").to_numpy(dtype=float)
170:    b = pd.Series(y, dtype=float).rank(method="average").to_numpy(dtype=float)
171:    if len(a) < 2:
172:        return np.nan
173:    a, b = a - a.mean(), b - b.mean()
174:    denominator = np.sqrt(np.dot(a, a) * np.dot(b, b))
175:    return float(np.dot(a, b) / denominator) if denominator > 0 else np.nan
176:
177:
178:def newey_west_t(values, lag=NW_LAG) -> float:
179:    """截距平均數的 Bartlett HAC；gamma_l 使用除以 n 的定義。"""
180:    x = np.asarray(values, dtype=float)
181:    x = x[np.isfinite(x)]
182:    n = len(x)
183:    if n < 2:
184:        return np.nan
185:    u = x - x.mean()
186:    long_run_variance = float(np.dot(u, u) / n)
187:    for ell in range(1, min(lag, n - 1) + 1):
188:        weight = 1 - ell / (lag + 1)
189:        long_run_variance += 2 * weight * float(np.dot(u[ell:], u[:-ell]) / n)
190:    if long_run_variance <= 0:
191:        return np.nan
192:    return float(x.mean() / np.sqrt(long_run_variance / n))
