  435: def scoring_targets(d, t, q_last, k) -> dict:
  436:     result = {"target4": None, "target_nc": None}
  437:     try:
  438:         actual = quarter_eps(d["qf"][t])
  439:         last = pd.Timestamp(q_last).to_period("Q-DEC")
  440: 
  441:         def total(end):
  442:             a = actual.reindex(
  443:                 pd.period_range(end=end, periods=4, freq="Q-DEC")
  444:             )
  445:             return float(a.sum()) if a.notna().all() else None
  446: 
  447:         result["target4"] = total(last + 4)
  448:         if k is not None and k >= 0:
  449:             result["target_nc"] = total(last + int(k))
  450:     except Exception as exc:
  451:         log_error(t, None, "scoring_targets", exc)
  452:     return result
  453: 
