403:        result["k"] = max(0, latest_month.asfreq("Q-DEC").ordinal - last.ordinal)
404:    if not np.isfinite(monthly.to_numpy(dtype=float)).all():
405:        _flag(result, "月營收有非有限值，視為缺值")
406:
407:    params = result["params"]
408:    params["g3"] = _growth(monthly, G3_MONTHS)
409:    params["g12"] = _growth(monthly, G12_MONTHS)
410:    params["g_far"] = (
411:        0.0
412:        if g_far_zero or params["g12"] is None
413:        else _number(params["g12"] * FAR_GROWTH_FACTOR)
414:    )
415:    if params["g12"] is None:
416:        _flag(result, "近十二月或去年同期月營收不足，遠季成長率用 0")
