  246: def remove_top_contributors(frame: pd.DataFrame, group: str) -> tuple:
  247:     """�H��դ��X�֥����W�B���[�`�^�m�ƧǡF�P�ɩҦ������[����ɲ����C"""
  248:     inside = frame.loc[frame[group].fillna(False).astype(bool)]
  249:     if inside.empty:
  250:         return frame.copy(), [], pd.DataFrame(columns=["t", "contribution"])
  251:     contribution = inside.groupby("t", as_index=False)["excess"].sum()
  252:     contribution["contribution"] = contribution["excess"] / len(inside)
  253:     contribution = contribution.sort_values(
