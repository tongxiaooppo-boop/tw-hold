176:def mean_value(frame: pd.DataFrame, column: str) -> float:
177:    if frame.empty:
178:        return np.nan
179:    values = pd.to_numeric(frame[column], errors="coerce").to_numpy(dtype=float)
180:    values = values[np.isfinite(values)]
181:    return float(values.mean()) if len(values) else np.nan
