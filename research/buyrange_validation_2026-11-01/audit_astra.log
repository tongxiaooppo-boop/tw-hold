167:def _gross_margin(frame: pd.DataFrame) -> float | None:
168:    if not _finite(frame, ("revenue", "gross_profit")):
169:        return None
170:    revenue = _number(frame["revenue"].sum())
171:    profit = _number(frame["gross_profit"].sum())
