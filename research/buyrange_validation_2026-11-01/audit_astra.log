  306: def population_tables(d, dates) -> tuple[pd.DataFrame, pd.DataFrame]:
  307:     rows, failures = [], []
  308:     for rd in dates:
  309:         audits = [_diagnostic(d, t, rd) for t in sorted(d["qf"])]
  310:         n_base = sum(a["base_eligible"] for a in audits)
  311:         nc = sum(a["nc_calculable"] for a in audits)
  312:         f4 = sum(a["f4_calculable"] for a in audits)
  313:         rows.append(
  314:             {
  315:                 "rd": pd.Timestamp(rd).date().isoformat(),
  316:                 "current_tickers": len(d["qf"]),
  317:                 "has_8q_and_gross": sum(
  318:                     a["has_8q"] and a["has_gross"] for a in audits
  319:                 ),
  320:                 "base_universe": n_base,
  321:                 "eligible": sum(a["eligible"] for a in audits),
  322:                 "NC_n": nc,
  323:                 "F4_n": f4,
  324:                 "NC_ratio": ratio(nc, n_base),
  325:                 "F4_ratio": ratio(f4, n_base),
  326:             }
  327:         )
  328:         counts = Counter(
  329:             reason
  330:             for a in audits
  331:             for reason in a["reason"].split(";")
  332:             if reason
  333:         )
  334:         for reason, n in sorted(counts.items()):
  335:             failures.append(
  336:                 {
  337:                     "rd": pd.Timestamp(rd).date().isoformat(),
  338:                     "reason": reason,
  339:                     "n": n,
  340:                 }
  341:             )
  342:     return (
  343:         pd.DataFrame(rows),
  344:         pd.DataFrame(failures, columns=["rd", "reason", "n"]),
  345:     )
