456:        _flag(result, "沒有月營收最新月，無法判定滾動季數")
457:        _fallback(result, ttm_details)
458:    elif k > MAX_NC_K:
459:        _flag(result, "月營收超前財報超過三季")
460:        _fallback(result, ttm_details)
461:    elif k > 0:
462:        actual_periods = pd.period_range(
463:            end=last, periods=TTM_QUARTERS - k, freq="Q-DEC"
464:        )
465:        actual = _actual_details(q, actual_periods)
466:        estimated = [estimates[period] for period in future[:k]]
467:        if actual is None:
468:            _flag(result, "滾動四季的實際 EPS 缺季或缺值")
