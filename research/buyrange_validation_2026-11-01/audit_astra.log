  216: def quarter_eps(q: pd.DataFrame) -> pd.Series:
  217:     """�u��ǤJ���u���B��F�ɻ��u�׮��I�ѩI�s�ݩ��T���w�C"""
  218:     periods = pd.DatetimeIndex(q["period_end"]).to_period("Q-DEC")
  219:     if periods.has_duplicates:
  220:         raise ValueError("�u���P�u����")
  221:     values = pd.to_numeric(q["eps"], errors="coerce").to_numpy(dtype=float).copy()
  222:     values[~np.isfinite(values)] = np.nan
  223:     return pd.Series(values, index=periods, dtype=float).sort_index()
  224: 
