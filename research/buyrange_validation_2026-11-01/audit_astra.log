194:
195:def yearly_block_ci(point_rows) -> tuple[float, float, int]:
196:    """整個重播年一起重抽，保留每年有效點數，以逐點IC平均為估計量。"""
197:    valid = [
198:        (pd.Timestamp(row["rd"]).year, number(row["ic"]))
199:        for row in point_rows
200:        if isfinite(row["ic"])
201:    ]
202:    years = sorted({year for year, _ in valid})
203:    if len(years) < 2:
204:        return np.nan, np.nan, len(years)
205:    sums = np.array(
206:        [sum(value for year, value in valid if year == y) for y in years],
207:        dtype=float,
208:    )
209:    counts = np.array(
210:        [sum(year == y for year, _ in valid) for y in years], dtype=float
211:    )
212:    rng = np.random.default_rng(BOOTSTRAP_SEED)
213:    selected = rng.integers(0, len(years), size=(BOOTSTRAP_DRAWS, len(years)))
214:    means = sums[selected].sum(axis=1) / counts[selected].sum(axis=1)
215:    lo, hi = np.percentile(means, [2.5, 97.5])
216:    return float(lo), float(hi), len(years)
