351:    gm = params["gm_ttm"] + _seasonal_bias(q, period)
352:    op = revenue * gm - params["opex_ratio"] * revenue
353:    eps = (
354:        (op + params["nonop_med"])
355:        * (1 - params["t"])
356:        * (1 - params["m"])
357:        / params["shares"]
358:    )
359:    if any(_number(value) is None for value in (revenue, gm, op, eps)):
360:        _flag(result, f"{period} 試算 EPS 或中間值非有限值")
