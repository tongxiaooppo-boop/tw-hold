  234: def compute_point(d, t, rd) -> dict | None:
  235:     rd = pd.Timestamp(rd)
  236:     audit = _diagnostic(d, t, rd)
  237:     pit = point_in_time(d, t, rd)
  238:     if pit is None:
  239:         return None
  240:     try:
  241:         q, monthly = pit["q"], pit["monthly"]
  242:         ttm = current_ttm(q)
  243:         if not isfinite(ttm):
  244:             audit["reason"] = "�̪�s��4�uEPS�ʭ�"
  245:             return None
  246:         if ttm <= 0:
  247:             audit["reason"] = "TTM�D��"
  248:             return None
  249:         audit["base_eligible"] = True
  250: 
  251:         nc = eps_nowcast.nowcast(q, monthly)
  252:         if not nc.get("ok", False):
  253:             audit["reason"] = "nowcast���ѡG" + str(nc.get("reason") or "������")
  254:             return None
  255:         ttm = number(nc.get("eps_ttm"))
  256:         if not isfinite(ttm) or ttm <= 0:
  257:             audit["reason"] = "nowcast��TTM�ʭȩΫD��"
  258:             return None
  259: 
  260:         eps_nc = number(nc.get("eps_nc"))
  261:         eps_f4 = number(nc.get("eps_f4"))
  262:         audit["eligible"] = True
  263:         audit["nc_calculable"] = isfinite(eps_nc)
  264:         audit["f4_calculable"] = isfinite(eps_f4)
  265:         missing = []
  266:         if not audit["nc_calculable"]:
  267:             missing.append("NC�ʭ�")
  268:         if not audit["f4_calculable"]:
  269:             missing.append("F4�ʭ�")
  270:         audit["reason"] = ";".join(missing)
  271: 
  272:         last = pd.Timestamp(nc["last_q"])
  273:         k_raw = nc.get("k")
  274:         k = int(k_raw) if k_raw is not None and isfinite(k_raw) else None
  275: 
  276:         # �Ȩѵ����G�^����줤 target* ���o�ѹw���B���h�οz��ϥΡC
  277:         targets = scoring_targets(d, t, last, k)
  278:         return {
