  255:     )
  256:     top = contribution.head(TOP_N)
  257:     tickers = top["t"].tolist()
  258:     remaining = frame.loc[~frame["t"].isin(tickers)].copy()
  259:     return remaining, tickers, top[["t", "contribution"]]
