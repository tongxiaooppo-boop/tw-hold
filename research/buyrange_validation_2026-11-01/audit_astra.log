418:    ttm_periods = pd.period_range(end=last, periods=TTM_QUARTERS, freq="Q-DEC")
419:    ttm_details = _actual_details(q, ttm_periods)
420:    result["eps_ttm"] = _sum_eps(ttm_details)
421:    if result["eps_ttm"] is None:
422:        ttm_details = None
423:        _flag(result, "已公布 TTM EPS 缺季或缺值")
424:
425:    future = pd.period_range(
426:        start=last + 1, periods=F4_QUARTERS, freq="Q-DEC"
427:    )
428:    result["f4_far_quarters"] = sum(
429:        not _has_monthly(monthly, period) for period in future
430:    )
431:
432:    k = result["k"]
433:    if k == 0:
434:        result["eps_nc"] = result["eps_ttm"]
435:        result["nc_quarters"] = ttm_details or []
436:
437:    calibration_error = _calibrate(q, result)
438:    if calibration_error is not None:
439:        if k != 0:
440:            _fallback(result, ttm_details)
441:        return _fail(result, calibration_error)
442:
443:    estimates = {
444:        period: _estimate(q, monthly, period, result) for period in future
445:    }
446:    f4_details = [estimates[period] for period in future]
447:    if all(detail is not None for detail in f4_details):
448:        eps_f4 = _sum_eps(f4_details)
449:        if eps_f4 is None:
