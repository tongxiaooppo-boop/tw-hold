  232: def group_metrics(frame: pd.DataFrame, group: str) -> dict:
  233:     mask = frame[group].fillna(False).astype(bool)
  234:     inside, outside = frame.loc[mask], frame.loc[~mask]
  235:     result = {
  236:         "group": group,
  237:         "n_buyable": len(frame),
  238:         **side_metrics(inside, "in"),
  239:         **side_metrics(outside, "out"),
  240:     }
  241:     result["spread"] = result["in_excess"] - result["out_excess"]
  242:     result["spread_net"] = result["in_excess_net"] - result["out_excess_net"]
  243:     return result
