69:def prediction_record(d, t, rd, point) -> dict:
70:    """純PIT選股路徑：不讀target*、進場open、出場close或未來報酬。"""
71:    result = {
72:        "t": t,
73:        "rd": rd,
74:        "buyable": False,
75:        "known_price_date": pd.NaT,
76:        "known_price": np.nan,
77:        "n_months": np.nan,
78:        "confidence": "未計算",
79:        "event_blocked": False,
80:        "reasons": [],
81:        **dict.fromkeys(GROUPS, False),
82:    }
83:    pit = point_in_time(d, t, rd)
84:    if pit is None:
85:        result["reasons"].append("PIT不可用")
86:        return result
87:
88:    q, monthly, per = pit["q"], pit["monthly"], pit["per"]
89:    b = multiples.band(
90:        per,
91:        "per",
92:        years=BAND_YEARS,
93:        min_months=MIN_MONTHS,
94:        cap=PE_CAP,
95:        asof=rd,
96:    )
97:    result["n_months"] = b.get("n_months", np.nan)
98:    p = multiples.prices(point["eps_nc"], b)
99:
100:    checks = [
101:        detect.nonop_gate(q),
102:        detect.revenue_caliber(q, monthly),
103:        detect.bridge_residual(q, point["params"]),
104:        detect.shares_check(q),
105:    ]
106:    checks.extend(
107:        detect.Check("NC旗標", "degrade", None, str(flag))
108:        for flag in point["flags"]
109:    )
110:    checks.extend(
111:        [
112:            detect.dist_check(b),
113:            detect.near_zero_eps(
114:                point["eps_nc"] if isfinite(point["eps_nc"]) else None, q
115:            ),
116:        ]
117:    )
118:    confidence = detect.confidence(checks)
119:    result["confidence"] = confidence["level"]
120:
121:    events_map = d.get("events", {})
122:    events = events_map.get(t)
123:    if events is None:
124:        result["reasons"].append("股數事件資料未知")
125:        result["event_blocked"] = True
126:    else:
127:        window_start = rd - pd.DateOffset(years=BAND_YEARS)
128:        for event_date, multiplier in events:
129:            event_date = pd.Timestamp(event_date)
130:            if not (window_start <= event_date < rd):
131:                continue
132:            multiplier = number(multiplier)
133:            if not isfinite(multiplier):
134:                result["event_blocked"] = True
135:                result["reasons"].append("窗內股數事件倍率缺值")
136:                break
137:            if round(abs(multiplier - 1), 9) >= EVENT_THRESHOLD:
138:                result["event_blocked"] = True
139:                result["reasons"].append("窗內股數事件>=3%")
140:                break
141:
142:    price_date, price = known_price(d, t, rd)
143:    result["known_price_date"] = price_date
144:    result["known_price"] = price
145:    if not b.get("ok", False):
146:        result["reasons"].append("PER有效月數不足")
147:    if p is None:
148:        result["reasons"].append("無法給三價")
149:    elif not all(
150:        isfinite(p.get(name)) and p[name] > 0
151:        for name in ("cheap", "fair", "dear")
152:    ):
153:        result["reasons"].append("三價非有限或非正")
154:    if confidence["level"] not in ("高", "中"):
155:        result["reasons"].append("可信度" + confidence["level"])
156:    if not isfinite(price) or price <= 0:
157:        result["reasons"].append("前一市場交易日收盤缺價")
158:
159:    if result["reasons"]:
160:        return result
161:
162:    result["buyable"] = True
163:    result["G0"] = bool(price <= p["fair"])
164:    f4, ttm = number(point["eps_f4"]), number(point["eps_ttm"])
165:    for group, factor in GROWTH_FACTORS.items():
166:        result[group] = bool(
167:            result["G0"] and isfinite(f4) and isfinite(ttm)
168:            and f4 >= factor * ttm
169:        )
170:    cheap = price <= p["cheap"]
171:    for group in MAIN_GROUPS:
172:        result[f"{group}_P20"] = bool(result[group] and cheap)
173:    return result
