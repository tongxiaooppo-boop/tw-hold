  348: def _price_frame(d, t) -> pd.DataFrame:
  349:     _sync(d)
  350:     if t not in _PRICES:
  351:         raw = d.get("px", {}).get(t)
  352:         if raw is None or raw.empty:
  353:             x = pd.DataFrame(
  354:                 columns=["open", "close"], index=pd.DatetimeIndex([], name="date")
  355:             )
  356:         else:
  357:             x = raw.loc[:, ["date", "open", "close"]].copy()
  358:             x["date"] = pd.to_datetime(x["date"])
  359:             x = x.dropna(subset=["date"]).drop_duplicates("date", keep="last")
  360:             x = x.set_index("date").sort_index()
  361:         _PRICES[t] = x
  362:     return _PRICES[t]
