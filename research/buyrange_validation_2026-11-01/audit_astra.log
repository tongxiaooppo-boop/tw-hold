190:def side_metrics(frame: pd.DataFrame, prefix: str) -> dict:
191:    result = {
192:        f"n_{prefix}": len(frame),
193:        f"stocks_{prefix}": frame["t"].nunique() if not frame.empty else 0,
194:        f"{prefix}_return": mean_value(frame, "ret"),
195:        f"{prefix}_return_net": mean_value(frame, "ret_net"),
196:        f"{prefix}_excess": mean_value(frame, "excess"),
197:        f"{prefix}_excess_net": mean_value(frame, "excess_net"),
198:        f"{prefix}_ew_return": mean_value(frame, "ew_return"),
199:        f"{prefix}_0050_return": mean_value(frame, "benchmark_0050"),
200:    }
201:    if frame.empty:
202:        for key in (
203:            "win_rate", "win_rate_net", "excess_win_rate",
204:            "excess_win_rate_net", "0050_excess", "0050_excess_net",
205:            "0050_win_rate", "0050_n",
206:        ):
207:            result[f"{prefix}_{key}"] = 0 if key == "0050_n" else np.nan
208:        return result
209:
210:    result[f"{prefix}_win_rate"] = positive_rate(frame["ret"])
211:    result[f"{prefix}_win_rate_net"] = positive_rate(frame["ret_net"])
212:    result[f"{prefix}_excess_win_rate"] = positive_rate(frame["excess"])
213:    result[f"{prefix}_excess_win_rate_net"] = positive_rate(frame["excess_net"])
214:    r = pd.to_numeric(frame["ret"], errors="coerce").to_numpy(dtype=float)
215:    b = pd.to_numeric(
216:        frame["benchmark_0050"], errors="coerce"
217:    ).to_numpy(dtype=float)
218:    valid = np.isfinite(r) & np.isfinite(b)
219:    result[f"{prefix}_0050_n"] = int(valid.sum())
220:    result[f"{prefix}_0050_excess"] = (
221:        float(np.mean(r[valid] - b[valid])) if valid.any() else np.nan
222:    )
223:    result[f"{prefix}_0050_excess_net"] = (
224:        float(np.mean(r[valid] - COST - b[valid])) if valid.any() else np.nan
225:    )
226:    result[f"{prefix}_0050_win_rate"] = (
227:        positive_rate(r[valid] - b[valid]) if valid.any() else np.nan
228:    )
229:    return result
