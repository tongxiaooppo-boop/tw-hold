  365: def known_price(d, t, rd) -> tuple[pd.Timestamp | None, float]:
  366:     """�i���e�@��������骺 close�G��Ū date<=rd�A���V�e�ɯʻ��C"""
  367:     x = _price_frame(d, t)
  368:     calendar = market_calendar(d)
  369:     i = calendar.searchsorted(pd.Timestamp(rd), side="right") - 1
  370:     if i < 0:
