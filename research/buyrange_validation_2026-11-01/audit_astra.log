  481: def scoring_trade(d, t, rd) -> dict:
  482:     schedule = scoring_schedule(d, rd)
  483:     result = {
  484:         **schedule,
  485:         "ok": False,
  486:         "ret": np.nan,
  487:         "ret_net": np.nan,
  488:         "benchmark_0050": np.nan,
  489:     }
  490:     if schedule["reason"]:
  491:         return result
  492:     try:
  493:         entry, exit_date = schedule["entry_date"], schedule["exit_date"]
  494:         x = _price_frame(d, t)
  495:         if entry not in x.index or exit_date not in x.index:
  496:             result["reason"] = "�i���ΥX�������ʻ�"
  497:             return result
  498:         open_entry = number(x.at[entry, "open"])
  499:         close_exit = number(x.at[exit_date, "close"])
  500:         if not (isfinite(open_entry) and isfinite(close_exit)):
  501:             result["reason"] = "�i�X�����D������"
  502:             return result
  503:         if open_entry <= 0 or close_exit <= 0:
  504:             result["reason"] = "�i�X�����D��"
  505:             return result
  506: 
  507:         result["ok"] = True
  508:         result["ret"] = close_exit / open_entry - 1
  509:         result["ret_net"] = result["ret"] - COST
  510:         result["reason"] = ""
  511: 
  512:         idx = d.get("idx0050")
  513:         if idx is not None and not idx.empty:
  514:             dates = pd.to_datetime(idx["date"])
  515:             a = idx.loc[dates.eq(entry), "close"]
  516:             b = idx.loc[dates.eq(exit_date), "close"]
  517:             if not a.empty and not b.empty:
  518:                 v0, v1 = number(a.iloc[-1]), number(b.iloc[-1])
  519:                 if isfinite(v0) and isfinite(v1) and v0 > 0 and v1 > 0:
  520:                     result["benchmark_0050"] = v1 / v0 - 1
  521:     except Exception as exc:
  522:         result["reason"] = "��������ҥ~"
  523:         result["ok"] = False
  524:         log_error(t, rd, "scoring_trade", exc)
  525:     return result

