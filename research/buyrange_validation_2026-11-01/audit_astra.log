499:        reduced, removed, contributions = remove_top_contributors(buyable, group)
500:        trimmed = group_metrics(reduced, group)
501:        point_spreads = point_frame.loc[
502:            point_frame["group"].eq(group), "spread"
503:        ].to_numpy(dtype=float)
