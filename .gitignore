__pycache__/
*.pyc
.venv/
.env
.env.*
*.token
*.pat

# ⚠️ 個人持倉——進場價 / 部位大小 / 投入金額。tw-hold 之後會是**公開 repo**
#    （PRD §10.1 裁決），這個檔一旦 commit 進公開歷史就洗不掉。
positions.json
positions.*.json
data/positions/

# 上游 bundle：拉下來的，可重建，不進版控（PRD §3.2）
data/upstream/
data/cache/
data/finmind_raw/

# ⚠️ data/derived/ **刻意進版控**——但只 commit 清單 JSON（小、可 diff、app 只讀這裡）。
#    factors.parquet 每天一顆 blob，一年會把 repo 撐到數百 MB → 放 Release 覆蓋。
data/derived/*.parquet

.streamlit/secrets.toml

# 自建上游資料：全歷史約百 MB 級，存 Release `selfhost-data`，不進 git（狀態小檔在 data/derived/）
data/selfhost/

# 私有參考資料（PCF 快照、總經／期貨／法人／指數序列）：來源網站條款禁止再散布，**不進公開 repo**。
# 存私有 repo tw-hold-data 的 Release refdata-latest（見 reference/refdata.py、scripts/refdata_sync.py）；
# CI 與 Streamlit app 執行期還原到這兩個目錄，本機開發照常讀寫。
data/pcf/
data/reference/
data/.refdata_pulled.json
